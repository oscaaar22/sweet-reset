# Copia este archivo como .env para probar en tu computadora.
# En Render estas variables se capturan en el panel (no subas .env a GitHub).

# Clave de la API de Anthropic: https://platform.claude.com (sección API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# PIN para la página /tienda (verificar y canjear cupones en caja)
PIN_TIENDA=2468

# Base de datos PostgreSQL. Si la dejas vacía se usa data/sweet-reset.json (solo pruebas).
# DATABASE_URL=postgresql://usuario:clave@host:5432/sweetreset

# Opcional
PORT=8787
# CLAUDE_MODEL=claude-opus-5-5
# Dirección pública de la app, para las URL de los QR
# SWEET_RESET_URL=https://sweet-reset.onrender.com
