{
  "name": "sweet-reset",
  "private": true,
  "version": "1.0.0",
  "description": "Sweet Reset by NutraSweets: experiencia digital de calma que acompaña al empaque.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"vite\" \"node --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "start": "node server/index.js",
    "codigos": "node scripts/generar-codigos.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
